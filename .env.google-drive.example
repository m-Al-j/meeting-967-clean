# Meeting 967 — Google Drive OAuth
GOOGLE_DRIVE_ENABLED=true

# OAuth 2.0 Desktop Client JSON الذي تنزله من Google Cloud.
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=/data/data/com.termux/files/home/meeting-967-clean/config/google-drive-oauth-client.json

# ينشئه npm run google-drive:authorize تلقائيًا. لا تشاركه مع أحد.
GOOGLE_DRIVE_OAUTH_TOKEN_FILE=/data/data/com.termux/files/home/meeting-967-clean/config/google-drive-oauth-token.json

# البوت ينشئ هذا المجلد تلقائيًا داخل My Drive.
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Meeting 967

# true = روابط ملفات التسجيل قابلة للفتح لمن يملك الرابط.
GOOGLE_DRIVE_PUBLIC_LINKS=true
